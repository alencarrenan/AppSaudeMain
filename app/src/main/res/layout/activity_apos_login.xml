<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- LOGO -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="250dp"
        android:layout_height="100dp"
        android:src="@drawable/logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/textView9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ESCOLHA UMA OPÇÃO"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/imageView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- IMAGEM REMÉDIOS -->

    <!-- IMAGEM CALENDÁRIO -->

    <!-- BOTÃO MEUS REMÉDIOS -->

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="48dp"
        android:src="@drawable/remedio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView9" />

    <!-- BOTÃO CALENDÁRIO -->

    <!-- IMAGEM DOENÇAS -->

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="24dp"
        android:src="@drawable/calendario"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView9" />

    <Button
        android:id="@+id/button4"
        android:layout_width="151dp"
        android:layout_height="62dp"
        android:layout_marginTop="16dp"
        android:text="Meus Remédios"
        app:layout_constraintTop_toBottomOf="@id/imageView3"
        tools:layout_editor_absoluteX="16dp" />

    <Button
        android:id="@+id/button6"
        android:layout_width="147dp"
        android:layout_height="57dp"
        android:layout_marginTop="24dp"
        android:text="Calendário"
        app:layout_constraintTop_toBottomOf="@id/imageView4"
        tools:layout_editor_absoluteX="220dp" />

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/doenca"
        app:layout_constraintTop_toBottomOf="@id/button4"
        tools:layout_editor_absoluteX="32dp" />

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="28dp"
        android:src="@drawable/cadastro"
        app:layout_constraintStart_toStartOf="@id/imageView4"
        app:layout_constraintTop_toBottomOf="@id/button6" />

    <Button
        android:id="@+id/button7"
        android:layout_width="154dp"
        android:layout_height="58dp"
        android:layout_marginTop="12dp"
        android:text="Minhas Doenças"
        app:layout_constraintTop_toBottomOf="@id/imageView5"
        tools:layout_editor_absoluteX="18dp" />

    <Button
        android:id="@+id/button8"   
        android:layout_width="153dp"
        android:layout_height="58dp"
        android:layout_marginTop="12dp"
        android:text="Meu Cadastro"
        app:layout_constraintTop_toBottomOf="@id/imageView6"
        tools:layout_editor_absoluteX="221dp" />

    <Button
        android:id="@+id/buttonVoltar1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Voltar"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/button7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
